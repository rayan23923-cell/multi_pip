{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskLens"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskLens"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم TaskLens الكاميرا فقط عندما تلتقط صورة لتقرأها العدسة. تُحلَّل الصورة على جهازك ولا تُرفع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskLens uses the camera only when you take a photo for Lens to read. The photo is analyzed on your device and is not uploaded."
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ TaskLens إطاراً واحداً من الشاشة التي تختارها، فقط بعد أن تضغط بدء ثم التقاط. يُقرأ على جهازك ولا يُحفظ ولا يُرفع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TaskLens reads one frame of the screen you choose, only after you tap Start and Capture. It is read on your device and not saved or uploaded."
          }
        }
      }
    }
  },
  "version": "1.0"
}