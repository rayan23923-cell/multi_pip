      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ نصاً أو رابطاً في جلسة، أو في الوارد إذا لم تكن هناك جلسة نشطة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves text or a link to a session, or to the inbox when no session is active."
