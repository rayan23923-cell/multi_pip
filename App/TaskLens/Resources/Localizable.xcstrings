    "intent.calculate.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحسب عملية مثل 12 × 3 + 4 على جهازك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculates an expression such as 12 × 3 + 4 on your device."
          }
        }
      }
    },
