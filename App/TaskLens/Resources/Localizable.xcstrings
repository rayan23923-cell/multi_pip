          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculate"
          }
        }
      }
    },
    "intent.convertCurrency.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضرب المبلغ في سعر الصرف الذي تحدده. لا يقوم TaskLens بتنزيل أسعار الصرف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplies an amount by the exchange rate you give. TaskLens does not download exchange rates."
          }
        }
      }
    },
