    "pip.limit.closed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُغلق عند إغلاق TaskLens، وقد يغلقها iOS بسبب مكالمة أو فيديو آخر. بطاقاتك محفوظة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It closes when TaskLens is closed, and iOS may close it for a call or another video. Your cards are kept."
          }
        }
      }
    },
    "pip.limit.ownContent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض محتوى TaskLens فقط. لا يمكنها وضع عناصر تحكم فوق التطبيقات الأخرى أو قراءة ما تعرضه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It shows TaskLens content only. It cannot place controls over other apps or read what they show."
          }
        }
      }
    },
    "pip.limit.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرض النافذة بطاقة واحدة كصورة. يمكنك تحريكها وتغيير حجمها وإخفاءها عند الحافة والضغط عليها للعودة. لا يمكن الكتابة أو الضغط داخلها؛ غيّر البطاقة من هنا وستتبعها النافذة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window shows one card as a picture. You can move it, resize it, hide it at the edge and tap it to return here. You cannot type or tap inside it; change cards here and the window follows."
          }
        }
      }
    },
    "pip.limit.start": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتحها iOS من داخل TaskLens فقط: عند الضغط على «بدء»، أو عند مغادرة التطبيق وهذه الشاشة مفتوحة (إذا كانت صورة داخل صورة التلقائية مفعّلة في الإعدادات)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS opens it only from TaskLens: when you tap Start, or when you leave the app while this screen is open (if automatic Picture in Picture is on in Settings)."
          }
        }
      }
    },
    "pip.limits.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
