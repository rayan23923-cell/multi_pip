      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البطاقات"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards"
          }
        }
      }
    },
    "pip.cards.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم «إبقاء في صورة داخل صورة» من ملاحظة أو صفحة مستند أو الحاسبة أو عنصر جلسة. اضغط بطاقة لعرضها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Keep in Picture in Picture from a note, a document page, the calculator or a session item. Tap a card to show it."
          }
        }
      }
    },
    "pip.emptyCard": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ملاحظة أو صفحة أو نتيجة لتبقى أمامك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a note, a page or a result to keep it in view."
          }
        }
      }
    },
    "pip.keep": {
