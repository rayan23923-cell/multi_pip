            "state": "translated",
            "value": "Export a Copy"
          }
        }
      }
    },
    "settings.data.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصدير ملف JSON يضم مساحات العمل والجلسات والملاحظات والسجل وسير العمل. تبقى الملفات المستوردة على هذا الآيفون. لا يتزامن TaskLens مع iCloud، وبياناتك ضمن النسخة الاحتياطية لجهازك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The export is a JSON file of your workspaces, sessions, notes, history and workflows. Imported files stay on this iPhone. TaskLens doesn't sync to iCloud; your data is included in your device backup."
          }
        }
      }
    },
