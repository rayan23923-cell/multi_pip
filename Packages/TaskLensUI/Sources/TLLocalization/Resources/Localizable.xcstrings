    "settings.data.deleteAllMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف مساحات العمل والجلسات والملاحظات والمستندات والحافظة والسجل وسير العمل ومفتاح خادم الذكاء الاصطناعي من هذا الآيفون. لا يمكن التراجع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workspaces, sessions, notes, documents, clipboard, history, workflows and the AI server key are deleted from this iPhone. This can't be undone."
          }
        }
      }
    },
    "settings.data.deleteAllTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف كل بيانات TaskLens؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all TaskLens data?"
          }
        }
      }
    },
    "settings.data.deleted": {
      "extractionState": "manual",
      "localizations": {
