        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيطلب iOS الآن الوصول إلى الكاميرا. يستخدم TaskLens الكاميرا فقط عندما تلتقط صورة لتقرأها العدسة. تُقرأ الصورة على هذا الجهاز ولا تُرفع ولا تُحفظ إلا إذا حفظت نتيجة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS will now ask for camera access. TaskLens uses the camera only when you take a photo for Lens to read. The photo is read on this device and isn't uploaded or kept unless you save a result."
          }
        }
      }
    },
