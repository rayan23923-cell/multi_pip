    "screenLens.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل عدسة الشاشة فقط بعد أن تضغط بدء وتختار ما تشاركه. يعرض iOS مؤشر التسجيل طوال عملها. يُقرأ إطار واحد على هذا الجهاز ثم يتوقف الالتقاط تلقائياً. لا تُحفظ الإطارات ولا تُرفع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Lens runs only after you tap Start and choose what to share. iOS shows its recording indicator while it runs. One frame is read on this device, then capture stops on its own. Frames are never saved or uploaded."
          }
        }
      }
    },
